# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_PATH=./data/selfpulse.db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-xxxx
JWT_EXPIRY=7d

# Notification Providers (optional)
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (future)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Location/Mapping Services
# Google Maps API
GOOGLE_MAPS_API_KEY=

# Logging
LOG_LEVEL=info
